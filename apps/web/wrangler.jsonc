// 學習端的 Workers Static Assets 設定（09 第 7.3 節）。只有 /assets/* 先執行 worker/index.js（找不到檔案時回 404），其他路徑完全由 Static Assets 回應。
// 自訂網域 ledgerland.swift.moe 在第一次正式部署時綁定（使用者決定）；在那之前只部署到 workers.dev。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ledgerland",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // none（2026-10-28 起）：auto-trailing-slash 會把 /index.html 以 307 轉到 /，Service Worker 的導覽 fallback 在 precache 沒有 index.html 時
    // 直接 fetch /index.html，拿到「有轉址」的回應，Safari 對導覽拒收（Response served by service worker has redirections）；
    // 站內路由本來就不是實際的 HTML 檔，只有 index.html 一個，拿掉結尾斜線的處理對其他網址沒有影響（06 第 3.3 節）
    "html_handling": "none",
    "run_worker_first": ["/assets/*"],
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false },
  // 自訂網域（09 第 7.3 節）：2026-10-22 使用者先在儀表板把這個主機名稱從 M0a 試作的 Worker 移除，之後才加回這段；由 CI 的 deploy workflow 綁定。
  "routes": [{ "pattern": "ledgerland.swift.moe", "custom_domain": true }],
}
