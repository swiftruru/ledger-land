{
  "name": "@ledgerland/web",
  "version": "0.0.0",
  "private": true,
  "description": "學習端 PWA：殼層、路由與頁面、Service Worker 與 manifest、_headers 範本、wrangler 設定",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "content:drafts": "LL_INCLUDE_DRAFTS=1 node ../../tools/content-build.mjs",
    "e2e:build": "LL_INCLUDE_DRAFTS=1 node ../../tools/content-build.mjs && pnpm build",
    "e2e:build:fixtures": "LL_INCLUDE_DRAFTS=1 node ../../tools/content-build.mjs && VITE_LL_FIXTURES=1 pnpm build",
    "build": "vite build && node ../../tools/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "cf:dev": "wrangler dev --port 8787",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "i18n:extract": "lingui extract --clean --overwrite",
    "i18n:check": "lingui extract --clean --overwrite && git diff --exit-code -- src/locales ../../packages/web-ui/src/locales && node ../../tools/lingui-missing.mjs ."
  },
  "dependencies": {
    "@ledgerland/content-schema": "workspace:*",
    "@ledgerland/core": "workspace:*",
    "@ledgerland/i18n": "workspace:*",
    "@ledgerland/progress": "workspace:*",
    "@ledgerland/quiz": "workspace:*",
    "@ledgerland/tokens": "workspace:*",
    "@ledgerland/web-ui": "workspace:*",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@zxing/library": "0.23.0",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "web-vitals": "6.2.3",
    "workbox-window": "7.4.1",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@phosphor-icons/core": "2.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "browserslist": "4.29.3",
    "lightningcss": "1.33.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "4.149.0"
  }
}
