{
  "$comment": "由 packages/content-schema 產生，不要手改；執行 pnpm schemas:build 重新產生。",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "chapterId": {
      "$ref": "#/definitions/__schema0"
    },
    "items": {
      "$ref": "#/definitions/__schema1"
    }
  },
  "required": [
    "chapterId",
    "items"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "string",
      "pattern": "^ch_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema1": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rev": {
            "$ref": "#/definitions/__schema2"
          },
          "revKind": {
            "$ref": "#/definitions/__schema3"
          },
          "status": {
            "$ref": "#/definitions/__schema4"
          },
          "supersededBy": {
            "$ref": "#/definitions/__schema5"
          },
          "retiredNote": {
            "$ref": "#/definitions/__schema6"
          },
          "authorNotes": {
            "$ref": "#/definitions/__schema9"
          },
          "updatedAt": {
            "$ref": "#/definitions/__schema10"
          },
          "id": {
            "$ref": "#/definitions/__schema11"
          },
          "chapterId": {
            "$ref": "#/definitions/__schema12"
          },
          "order": {
            "$ref": "#/definitions/__schema13"
          },
          "statement": {
            "$ref": "#/definitions/LocalizedText"
          },
          "skill": {
            "$ref": "#/definitions/__schema14"
          },
          "misconceptions": {
            "$ref": "#/definitions/__schema15"
          },
          "plannedQuestions": {
            "$ref": "#/definitions/__schema17"
          },
          "suggestedTypes": {
            "$ref": "#/definitions/__schema18"
          },
          "termRefs": {
            "$ref": "#/definitions/__schema19"
          },
          "labRefs": {
            "$ref": "#/definitions/__schema20"
          },
          "pendingRefs": {
            "$ref": "#/definitions/__schema23"
          }
        },
        "required": [
          "rev",
          "revKind",
          "status",
          "id",
          "chapterId",
          "order",
          "statement",
          "skill",
          "plannedQuestions"
        ],
        "additionalProperties": false
      }
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "text",
        "answer"
      ]
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "allOf": [
        {
          "$ref": "#/definitions/LocalizedText"
        }
      ]
    },
    "LocalizedText": {
      "type": "object",
      "properties": {
        "zh-TW": {
          "$ref": "#/definitions/__schema7"
        },
        "en": {
          "$ref": "#/definitions/__schema8"
        }
      },
      "required": [
        "zh-TW"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "string"
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema11": {
      "type": "string",
      "pattern": "^obj_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema12": {
      "type": "string",
      "pattern": "^ch_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema13": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "identify",
        "classify",
        "compute",
        "interpret",
        "judge"
      ]
    },
    "__schema15": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Misconception"
      }
    },
    "Misconception": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/__schema16"
        },
        "text": {
          "$ref": "#/definitions/LocalizedText"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "pattern": "^mc_[0123456789abcdefghjkmnpqrstvwxyz]{4}$"
    },
    "__schema17": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema18": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "single_choice",
          "true_false",
          "pick_statement",
          "pick_line",
          "classify",
          "transaction_effect",
          "five_step_fill",
          "ratio_numeric",
          "ratio_interpret",
          "judgment",
          "journal_entry",
          "multi_choice"
        ]
      }
    },
    "__schema19": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tm_[0123456789abcdefghjkmnpqrstvwxyz]{8}$"
      }
    },
    "__schema20": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LabRef"
      }
    },
    "LabRef": {
      "type": "object",
      "properties": {
        "story": {
          "$ref": "#/definitions/__schema21"
        },
        "step": {
          "$ref": "#/definitions/__schema22"
        }
      },
      "required": [
        "story",
        "step"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "string",
      "pattern": "^story_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema22": {
      "type": "string",
      "pattern": "^st_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema23": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PendingRef"
      }
    },
    "PendingRef": {
      "type": "string",
      "pattern": "^T\\d{2}$"
    }
  }
}
