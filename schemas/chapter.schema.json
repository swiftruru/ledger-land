{
  "$comment": "由 packages/content-schema 產生，不要手改；執行 pnpm schemas:build 重新產生。",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "rev": {
      "$ref": "#/definitions/__schema0"
    },
    "revKind": {
      "$ref": "#/definitions/__schema1"
    },
    "status": {
      "$ref": "#/definitions/__schema2"
    },
    "supersededBy": {
      "$ref": "#/definitions/__schema3"
    },
    "retiredNote": {
      "$ref": "#/definitions/__schema4"
    },
    "authorNotes": {
      "$ref": "#/definitions/__schema7"
    },
    "updatedAt": {
      "$ref": "#/definitions/__schema8"
    },
    "id": {
      "$ref": "#/definitions/__schema9"
    },
    "order": {
      "$ref": "#/definitions/__schema10"
    },
    "scope": {
      "$ref": "#/definitions/__schema11"
    },
    "examScope": {
      "$ref": "#/definitions/__schema12"
    },
    "kind": {
      "$ref": "#/definitions/__schema13"
    },
    "notices": {
      "$ref": "#/definitions/__schema14"
    },
    "title": {
      "$ref": "#/definitions/LocalizedText"
    },
    "summary": {
      "$ref": "#/definitions/LocalizedText"
    },
    "objectiveIds": {
      "$ref": "#/definitions/__schema16"
    },
    "levelIds": {
      "$ref": "#/definitions/__schema17"
    },
    "prerequisites": {
      "$ref": "#/definitions/__schema18"
    },
    "badge": {
      "$ref": "#/definitions/__schema19"
    },
    "chapterEndLinks": {
      "$ref": "#/definitions/__schema20"
    },
    "termRefs": {
      "$ref": "#/definitions/__schema21"
    }
  },
  "required": [
    "rev",
    "revKind",
    "status",
    "id",
    "order",
    "scope",
    "examScope",
    "title",
    "summary",
    "objectiveIds",
    "levelIds"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "text",
        "answer"
      ]
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "allOf": [
        {
          "$ref": "#/definitions/LocalizedText"
        }
      ]
    },
    "LocalizedText": {
      "type": "object",
      "properties": {
        "zh-TW": {
          "$ref": "#/definitions/__schema5"
        },
        "en": {
          "$ref": "#/definitions/__schema6"
        }
      },
      "required": [
        "zh-TW"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    },
    "__schema6": {
      "type": "string",
      "minLength": 1
    },
    "__schema7": {
      "type": "string"
    },
    "__schema8": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema9": {
      "type": "string",
      "pattern": "^ch_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "__schema10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "core",
        "extension"
      ]
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "midterm",
        "not_in_exam",
        "unconfirmed"
      ]
    },
    "__schema13": {
      "type": "string",
      "enum": [
        "journal"
      ]
    },
    "__schema14": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema15"
      }
    },
    "__schema15": {
      "type": "string",
      "enum": [
        "not_investment_advice"
      ]
    },
    "__schema16": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^obj_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
      }
    },
    "__schema17": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^lv_[0123456789abcdefghjkmnpqrstvwxyz]{8}$"
      }
    },
    "__schema18": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ch_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
      }
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        }
      },
      "required": [
        "icon",
        "title"
      ],
      "additionalProperties": false
    },
    "__schema20": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "lab"
          },
          "story": {
            "type": "string",
            "pattern": "^story_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
          },
          "step": {
            "type": "string",
            "pattern": "^st_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
          }
        },
        "required": [
          "kind",
          "story",
          "step"
        ],
        "additionalProperties": false
      }
    },
    "__schema21": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tm_[0123456789abcdefghjkmnpqrstvwxyz]{8}$"
      }
    }
  }
}
