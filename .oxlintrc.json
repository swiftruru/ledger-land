{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-underscore-dangle": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "no-shadow": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".pnpm-store",
    ".cache",
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "prototypes",
    "references",
    "**/generated/**",
    "apps/web/dev-dist",
    "**/*.po"
  ],
  "overrides": [
    {
      "files": [
        "packages/tokens/src/**",
        "packages/i18n/src/**",
        "packages/content-schema/src/**",
        "packages/core/src/**",
        "packages/quiz/src/**",
        "packages/progress/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "純 TypeScript 套件不碰 React（09 第 8.3 節）"
              },
              {
                "name": "react-dom",
                "message": "純 TypeScript 套件不碰 DOM（09 第 8.3 節）"
              },
              {
                "name": "vite",
                "message": "純 TypeScript 套件不依賴 Vite（09 第 8.3 節）"
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "純 TypeScript 套件不用 Node 專屬 API（09 第 8.3 節）"
              },
              {
                "group": ["react/*", "react-dom/*"],
                "message": "純 TypeScript 套件不碰 React（09 第 8.3 節）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tools/**", "**/scripts/**", "**/*.config.ts", "**/*.config.mjs"],
      "env": {
        "node": true
      }
    }
  ]
}
