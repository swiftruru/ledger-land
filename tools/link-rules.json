{
  "note": "check:links（tools/check-links.mjs，站規 4.1）的規則設定。新增設計系統檔案、保留 class 或允許的祖先都要改這個檔，PR 一眼看得到；例外另寫在 tools/link-exceptions.json。",
  "dsFiles": [
    "packages/web-ui/src/components/Button.tsx",
    "packages/web-ui/src/components/IconButton.tsx",
    "packages/web-ui/src/components/BackButton.tsx",
    "packages/web-ui/src/components/TopBar.tsx",
    "packages/web-ui/src/components/PageHeader.tsx",
    "packages/web-ui/src/components/StatChip.tsx",
    "packages/web-ui/src/components/NavList.tsx",
    "packages/web-ui/src/components/Disclosure.tsx",
    "packages/web-ui/src/components/Menu.tsx",
    "packages/web-ui/src/components/GlossaryItem.tsx",
    "packages/web-ui/src/components/TextLink.tsx",
    "packages/web-ui/src/components/link-context.tsx",
    "packages/web-ui/src/components/ChapterBanner.tsx",
    "apps/web/src/components/RouterLink.tsx"
  ],
  "routerLinkFiles": ["apps/web/src/components/RouterLink.tsx"],
  "routerModules": ["react-router", "react-router-dom"],
  "routerLinkExports": ["Link", "NavLink"],
  "buttonDirs": ["packages/web-ui/src/components/"],
  "reservedClasses": ["btn", "iconbtn", "navrow", "navcard", "navlist", "termitem", "termpill", "link", "statchip", "menuitem", "disclosure", "chbanner__link"],
  "suggest": {
    "btn": "<Button>",
    "iconbtn": "<IconButton>",
    "navrow": "<NavRow>",
    "navcard": "<NavCard>",
    "navlist": "<NavList>",
    "termitem": "<GlossaryItem>",
    "termpill": "<TermPill>",
    "link": "<TextLink>",
    "statchip": "<StatChip>",
    "menuitem": "<MenuItem>",
    "disclosure": "<Disclosure>",
    "chbanner__link": "<ChapterBanner>"
  },
  "allowedAncestors": ["ll-navlist", "ll-navcard", "ll-btnrow", "ll-chbanner"],
  "globalAnchorFiles": ["apps/web/src/styles/base.css", "apps/web/src/styles/dev.css", "packages/web-ui/src/styles/07-core-components.css"],
  "linkClasses": ["ll-link"],
  "visitedClasses": ["ll-link", "ll-btn"],
  "textDecorationNoneClasses": ["ll-tabbar__link", "ll-skiplink"],
  "htmlAnchorClasses": {
    "apps/web/src/shell/shellHtml.ts": ["ll-tabbar__link"],
    "apps/web/index.html": ["ll-skiplink"]
  },
  "nonInteractiveElements": ["div", "span", "li", "p", "img", "section", "article", "td", "tr"],
  "nonInteractiveHandlers": ["onClick", "onKeyDown"],
  "forbiddenRoles": ["link", "button"],
  "polymorphicProps": ["as", "component", "asChild"],
  "listClassPattern": "^ll-list(--[\\w-]+)?$",
  "listForbidden": {
    "a": true,
    "Link": true,
    "NavLink": true,
    "RouterLink": true,
    "Button": "href",
    "IconButton": "href",
    "BackButton": true,
    "NavList": true,
    "NavRow": true,
    "NavCard": true,
    "GlossaryItem": true,
    "TermPill": true,
    "StatChip": true
  },
  "dsComponents": [
    "Button",
    "IconButton",
    "BackButton",
    "TopBar",
    "PageHeader",
    "StatChip",
    "NavList",
    "NavRow",
    "NavCard",
    "Disclosure",
    "MenuButton",
    "MenuItem",
    "GlossaryItem",
    "TermPill",
    "GlossaryGrid",
    "TextLink",
    "ChapterBanner",
    "RouterLink",
    "UiLink",
    "Link",
    "NavLink"
  ],
  "styleDecorationProps": ["textDecoration", "textDecorationLine", "textUnderlineOffset", "WebkitTextDecoration", "WebkitTextDecorationLine"],
  "styleColorProps": ["color"]
}
