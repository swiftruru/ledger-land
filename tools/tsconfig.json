{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noUncheckedIndexedAccess": false,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["*.mjs", "lib/**/*.mjs", "local/**/*.mjs"]
}
