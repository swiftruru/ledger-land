  {
    "id": "deferred_organisation_costs",
    "order": 120,
    "element": "asset",
    "section": "deferred_asset",
    "normalSide": "debit",
    "current": false,
    "contraOf": null,
    "allowNegative": false,
    "enabledByDefault": true,
    "teacherCell": "L24",
    "labels": {
      "teacher": {
        "zh-TW": "設立費",
        "en": "Start-up costs"
      },
      "currentTw": null,
      "ifrsEn": null,
      "aliases": {
        "zh-TW": ["開辦費"],
        "en": ["Establishment costs", "Organisation costs"]
      }
    },
    "termRef": "tm_d9f3g7cs",
    "flags": ["japanese", "not_ifrs_line", "ifrs_treatment_differs"],
    "ifrsTreatment": {
      "note": {
        "zh-TW": "IAS 38.69 規定開辦活動的支出在發生時認列為費用，不能列為資產。",
        "en": "Under IAS 38.69, expenditure on start-up activities is recognised as an expense when it is incurred."
      },
      "amountImpact": {
        "zh-TW": "改用 IFRS 時，取得當期的費用增加、之後各期不再攤銷；付出的現金由投資活動改列營業活動。",
        "en": "Under IFRS the expense is higher in the period of payment and there is no later amortisation. The cash paid moves from investing to operating activities."
      }
    },
    "cashFlow": {
      "indirect": "via_cash_tag",
      "defaultActivity": "investing"
    },
    "pendingRefs": ["T04", "T05", "T30"]
  },
  {
    "id": "deferred_development_costs",
    "order": 130,
    "element": "asset",
    "section": "deferred_asset",
    "normalSide": "debit",
    "current": false,
    "contraOf": null,
    "allowNegative": false,
    "enabledByDefault": true,
    "teacherCell": "L25",
    "labels": {
      "teacher": {
        "zh-TW": "開發費",
        "en": "Development costs"
      },
      "currentTw": null,
      "ifrsEn": null,
      "aliases": {
        "zh-TW": [],
        "en": []
      }
    },
    "termRef": "tm_7nja2cvf",
    "flags": ["japanese", "not_ifrs_line", "ifrs_treatment_differs", "unused"],
    "ifrsTreatment": {
      "note": {
        "zh-TW": "IAS 38.57 只允許符合六項條件的開發階段支出列為無形資產，研究階段與不符合條件的開發支出都在發生時認列為費用。",
        "en": "IAS 38.57 allows development expenditure to be recognised as an intangible asset only when six conditions are met. Research expenditure and development expenditure that does not qualify are expensed when incurred."
      },
      "amountImpact": {
        "zh-TW": "改用 IFRS 時，不符合條件的部分在支出當期列費用，資產與之後各期的攤銷都減少；符合條件的部分改列無形資產。",
        "en": "Under IFRS the part that does not qualify is expensed in the period of payment, so assets and later amortisation are lower; the part that qualifies is presented as an intangible asset."
      }
    },
    "cashFlow": {
      "indirect": "via_cash_tag",
      "defaultActivity": "investing"
    },
    "pendingRefs": ["T04"]
  },
